{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "Pay2GPT",
  "description": "__MSG_description__",
  "version": "1.0.0",
  "default_locale": "en",
  "homepage_url": "https://pay2gpt.com/",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://pay2gpt.com/*",
    "https://ru.pay2gpt.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pay2gpt.com/*",
        "https://ru.pay2gpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
